diff --git a/triplets/wasm32-emscripten-wasmeh-toolchain.cmake b/triplets/wasm32-emscripten-wasmeh-toolchain.cmake
new file mode 100644
index 0000000..e2093e4
--- /dev/null
+++ b/triplets/wasm32-emscripten-wasmeh-toolchain.cmake
@@ -0,0 +1,10 @@
+# Zero Hour (danyllo153) 14/11/2026 Chainload toolchain for the wasm32-emscripten-wasmeh triplet.
+# vcpkg ignores VCPKG_C_FLAGS/VCPKG_CXX_FLAGS when a chainload toolchain is set, so the flags go here.
+if(DEFINED ENV{EMSCRIPTEN_ROOT})
+    set(_zh_emscripten_root "$ENV{EMSCRIPTEN_ROOT}")
+else()
+    set(_zh_emscripten_root "$ENV{EMSDK}/upstream/emscripten")
+endif()
+include("${_zh_emscripten_root}/cmake/Modules/Platform/Emscripten.cmake")
+string(APPEND CMAKE_C_FLAGS_INIT " -sSUPPORT_LONGJMP=wasm")
+string(APPEND CMAKE_CXX_FLAGS_INIT " -sSUPPORT_LONGJMP=wasm -fwasm-exceptions")
diff --git a/triplets/wasm32-emscripten-wasmeh.cmake b/triplets/wasm32-emscripten-wasmeh.cmake
new file mode 100644
index 0000000..ff9b249
--- /dev/null
+++ b/triplets/wasm32-emscripten-wasmeh.cmake
@@ -0,0 +1,30 @@
+set(VCPKG_ENV_PASSTHROUGH_UNTRACKED EMSCRIPTEN_ROOT EMSDK PATH)
+
+if(NOT DEFINED ENV{EMSCRIPTEN_ROOT})
+   find_path(EMSCRIPTEN_ROOT "emcc")
+else()
+   set(EMSCRIPTEN_ROOT "$ENV{EMSCRIPTEN_ROOT}")
+endif()
+
+if(NOT EMSCRIPTEN_ROOT)
+   if(NOT DEFINED ENV{EMSDK})
+      message(FATAL_ERROR "The emcc compiler not found in PATH")
+   endif()
+   set(EMSCRIPTEN_ROOT "$ENV{EMSDK}/upstream/emscripten")
+endif()
+
+if(NOT EXISTS "${EMSCRIPTEN_ROOT}/cmake/Modules/Platform/Emscripten.cmake")
+   message(FATAL_ERROR "Emscripten.cmake toolchain file not found")
+endif()
+
+set(VCPKG_TARGET_ARCHITECTURE wasm32)
+set(VCPKG_CRT_LINKAGE dynamic)
+set(VCPKG_LIBRARY_LINKAGE static)
+set(VCPKG_CMAKE_SYSTEM_NAME Emscripten)
+set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${EMSCRIPTEN_ROOT}/cmake/Modules/Platform/Emscripten.cmake")
+
+# Zero Hour (danyllo153) 14/11/2026 For the GENERALSX_WEB_JSPI build: native wasm exceptions and wasm
+# setjmp/longjmp. Libraries built with the default (JS-emulated) setjmp leave emscripten_longjmp
+# undefined at link time once the engine links with -sSUPPORT_LONGJMP=wasm. vcpkg does not pass
+# VCPKG_C_FLAGS to a chainloaded toolchain, so a wrapper toolchain adds the flags.
+set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/wasm32-emscripten-wasmeh-toolchain.cmake")
