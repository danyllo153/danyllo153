diff --git a/GeneralsMD/Code/GameEngineDevice/Source/SDL3GameEngine.cpp b/GeneralsMD/Code/GameEngineDevice/Source/SDL3GameEngine.cpp
index b08126c..bf6ca10 100644
--- a/GeneralsMD/Code/GameEngineDevice/Source/SDL3GameEngine.cpp
+++ b/GeneralsMD/Code/GameEngineDevice/Source/SDL3GameEngine.cpp
@@ -499,17 +499,64 @@ void SDL3GameEngine::update(void)
 /**
  * From GameEngine: execute() - main game loop
  */
+#if defined(__EMSCRIPTEN__)
+static void* s_gxPumpEngine = nullptr;
+static Bool s_gxInFrame = FALSE;
+#endif
+
 void SDL3GameEngine::execute(void)
 {
 	fprintf(stderr, "INFO: SDL3GameEngine::execute() - entering main loop\n");
 #if defined(__EMSCRIPTEN__)
 	// GeneralsX @port Codex 04/08/2026 Let Chrome own frame scheduling and keep the engine alive.
 	TheFramePacer->reset();
+#if defined(GENERALSX_WEB_JSPI)
+	// Zero Hour (danyllo153) 14/11/2026 With JSPI a frame may only suspend (emscripten_sleep) inside a
+	// WebAssembly.promising export, and emscripten's main loop calls frames through the function table,
+	// which is not promising. Drive frames from JS through the GeneralsXPump export instead (listed in
+	// JSPI_EXPORTS); a frame is never started while the previous one is still running.
+	// Zero Hour (danyllo153) 15/11/2026 Pace with requestAnimationFrame (one frame per monitor refresh,
+	// not capped at ~60 like the 16 ms timer). rAF stops when the window is unfocused or occluded, which
+	// would freeze one LAN peer (reason for the timer in the Asyncify build below), so a 16 ms timer runs
+	// a frame whenever rAF has not delivered one for 50 ms. ?fpscap=1 restores the old 16 ms pacing.
+	s_gxPumpEngine = this;
+	EM_ASM({
+		const pump = Module["_GeneralsXPump"];
+		const capped = new URLSearchParams(location.search).get("fpscap") === "1";
+		let running = false;
+		let last = performance.now();
+		const frame = async () => {
+			if (running || Module["__gxStopLoop"]) return;
+			running = true;
+			last = performance.now();
+			try {
+				await pump();
+			} catch (error) {
+				if (error !== "unwind") console.error("GeneralsXPump", error);
+			}
+			running = false;
+		};
+		if (!capped) {
+			const onAnimationFrame = () => {
+				if (Module["__gxStopLoop"]) return;
+				frame();
+				requestAnimationFrame(onAnimationFrame);
+			};
+			requestAnimationFrame(onAnimationFrame);
+		}
+		const timer = setInterval(() => {
+			if (Module["__gxStopLoop"]) { clearInterval(timer); return; }
+			if (capped || performance.now() - last >= 50) frame();
+		}, 16);
+	});
+	emscripten_exit_with_live_runtime();
+#else
 	emscripten_set_main_loop_arg(browserFrame, this, 0, true);
 	// GeneralsX @bugfix Codex 06/08/2026 requestAnimationFrame stops in a window that is unfocused or
 	// occluded (macOS marks background windows occluded), which freezes one LAN client while its peer
 	// keeps simulating — the match then starts desynced. setTimeout keeps stepping regardless of focus.
 	emscripten_set_main_loop_timing(EM_TIMING_SETTIMEOUT, 16);
+#endif
 #else
 	GameEngine::execute();
 	fprintf(stderr, "INFO: SDL3GameEngine::execute() - exited main loop\n");
@@ -521,8 +568,6 @@ void SDL3GameEngine::execute(void)
 // loop and desyncs LAN peers. The page drives frames from a worker while hidden via this export.
 // The guard makes overlapping entry impossible: executeFrame can suspend in emscripten_sleep,
 // and a pump arriving during that suspension must be dropped, not run reentrantly.
-static void* s_gxPumpEngine = nullptr;
-static Bool s_gxInFrame = FALSE;
 
 extern "C" EMSCRIPTEN_KEEPALIVE void GeneralsXPump(void)
 {
@@ -540,7 +585,11 @@ void SDL3GameEngine::browserFrame(void* enginePointer)
 	if (engine->getQuitting())
 	{
 		s_gxInFrame = FALSE;
+#if defined(GENERALSX_WEB_JSPI)
+		EM_ASM({ Module["__gxStopLoop"] = 1; });
+#else
 		emscripten_cancel_main_loop();
+#endif
 		return;
 	}
 
